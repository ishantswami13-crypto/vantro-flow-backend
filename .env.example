# ============================================
# VANTRO FLOW BACKEND — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to git
# ============================================

# ── Supabase ────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here # NEVER commit this
SUPABASE_ANON_KEY=your-anon-key-here                 # Public anon key
SUPABASE_KEY=your-service-role-key                   # Legacy support

# ── Auth ────────────────────────────────────
JWT_SECRET=replace-with-64-char-random-string  # REQUIRED — generate: openssl rand -hex 32

# ── Environment ─────────────────────────────
NODE_ENV=development                           # Keep development for local/test
TEST_MODE=true                                 # Set to true for Cortex tests
CORTEX_TEST_MODE=true                          # Enables test-only endpoints like auth-test

# ── Database (Supabase Direct Postgres) ────
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# Get from: Supabase → Settings → Database → Connection String → URI

# ── AI / LLM ────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# Scanner fallback order. Default: groq,gemini,openrouter,huggingface,ocrspace
SCAN_AI_PROVIDERS=groq,gemini,openrouter,huggingface,ocrspace
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GEMINI_API_KEY=...
GEMINI_VISION_MODEL=gemini-3.5-flash
OPENROUTER_API_KEY=...
OPENROUTER_VISION_MODELS=qwen/qwen2.5-vl-72b-instruct:free,qwen/qwen2.5-vl-32b-instruct:free
HF_TOKEN=...
HF_VISION_MODEL=zai-org/GLM-4.5V
OCRSPACE_API_KEY=helloworld

# ── Payments (Razorpay) ─────────────────────
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# ── Push Notifications (VAPID) ──────────────
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_EMAIL=hello@vantroflow.com
# Generate: npx web-push generate-vapid-keys

# ── Twilio (Voice Calls) ────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxx
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ── WhatsApp ─────────────────────────────────
# Per-user WhatsApp credentials stored in DB (set via /api/settings/twilio)
# These are NOT server-level env vars

# ── CORS ─────────────────────────────────────
ALLOWED_ORIGINS=https://vantroflow.com,https://www.vantroflow.com
# Comma-separated exact origins the frontend is served from. The frontend's
# origin MUST be listed here or the browser blocks every API call, login first.

# Vercel preview deployments get a generated subdomain per commit, so they can't
# be listed above. These control which previews are trusted:
VERCEL_PROJECT_SLUGS=vantro-flow-frontend
# Comma-separated Vercel project names. Set this if the Vercel project is
# renamed — otherwise its preview URLs are rejected.
# VERCEL_TEAM_SCOPE=your-team-slug
# Optional hardening: preview hosts look like <slug>-<hash>-<scope>.vercel.app.
# Setting this pins previews to your team. Without it, a lookalike project whose
# name starts with the same slug would also be accepted.

# ── Feature Flags (Cortex / AI) ──────────────
# Every AI and agent feature is gated here and defaults to OFF. With none of
# these set, the app runs as plain CRUD: no agents, no scoring, no AI actions,
# no memory. If the "intelligent" side appears to do nothing, this is why.
# Only the literal string "true" enables a flag. Defined in lib/featureFlags.js.
# Check what is live at runtime with: npm run verify:connection

# Master switch. Nothing else in this section does anything while it is off.
FEATURE_CORTEX_ENABLED=true

# Safe to enable — these compute and persist, but never contact a customer.
FEATURE_AI_ACTION_CENTER=true            # surface the AI Action Center
FEATURE_CUSTOMER_SCORING=true            # compute + persist customer_scores
FEATURE_PROMISE_CHECKER=true             # daily broken-promise detection
FEATURE_CASHFLOW_FORECAST=true           # richer cashflow_events
FEATURE_LOW_STOCK_ALERTS=true            # low stock -> ai_actions
FEATURE_CREDIT_RISK_WARNING=true         # credit risk -> ai_actions
FEATURE_AI_MESSAGE_DRAFTS=true           # draft messages on action cards
FEATURE_MEMORY_ENABLED=true              # business_memory + ai_plans + tool_calls
FEATURE_WORKFLOW_RUNNER_ENABLED=true     # durable workflow_runs tracking
FEATURE_LEARNING_LOOP_ENABLED=true       # outcomes feed back into memory
FEATURE_SIMULATION_ENGINE_ENABLED=true   # simulate risky events

# Needs ANTHROPIC_API_KEY. Without the key, planning falls back to rules.
FEATURE_AGENT_PLANNER_ENABLED=true

# Sanitizes untrusted text before it reaches an LLM. Defaults ON — the only
# flag that must be set to the string "false" to disable. Leave it alone.
# FEATURE_PROMPT_GUARD_ENABLED=true

# ── Flags that cause real-world side effects — leave OFF until reviewed ──
# Each of these acts on customers, suppliers or your books without a human in
# the loop. Turn them on one at a time, and only after watching the drafts the
# safe flags above produce.

# Allows ALL outbound WhatsApp/Twilio sends. OFF = drafts only, nothing leaves.
FEATURE_EXTERNAL_MESSAGE_SENDING_ENABLED=false
# Lets agents auto-draft supplier POs, prepare payments and send escalations.
# Requires the sending flag above as well — both must be true to send.
FEATURE_AGENT_AUTOEXECUTE_ENABLED=false
# Auto-marks invoices/sales/purchases paid on high-confidence bank matches.
# OFF = every imported transaction waits for owner review.
FEATURE_BANK_RECONCILIATION_ENABLED=false
# Exposes cortex-lab test scenarios at runtime. Keep off in production.
FEATURE_CORTEX_LAB_ENABLED=false
# Tally ERP ingestion via /api/import/tally.
FEATURE_TALLY_IMPORT_ENABLED=false

# ── Server ───────────────────────────────────
PORT=3001
NODE_ENV=production
